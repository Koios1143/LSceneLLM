# Copy to env.sh (gitignored) and fill in. Every extra_eval/*.sh sources it from the repo root.
# Keep this project's own copy of every dependency under deps/ (gitignored; hard links or copies,
# a symlink only into a directory this project owns) and point the variables there.
# The ${VAR:-...} form lets a value given on the command line override this file.

# --- environment (build_env.sh) ---
export LSCENELLM_ENV="${LSCENELLM_ENV:-/path/to/lscenellm-venv}"
export LSCENELLM_CUDA_HOME="${LSCENELLM_CUDA_HOME:-/usr/local/cuda}"   # CUDA >= 12.8 toolkit
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/cache/uv}"
export HF_HOME="${HF_HOME:-/path/to/cache/huggingface}"

# --- XR-QA (run_xrqa.sh) ---
export MINK_ENV="${MINK_ENV:-/path/to/minkowski-venv}"   # python env with MinkowskiEngine + torch (OpenScene features)
export JAVA_HOME="${JAVA_HOME:-/path/to/jre}"             # METEOR
# export EXP_NAME=release_xrqa

# --- ScanNet-family benchmarks (run_infer.sh / score.sh) ---
export EXTRA_ANNO="${EXTRA_ANNO:-/path/to/annotations}"          # ScanRefer/ ScanQA/ sqa3d_test.json real3dqa/
export SCANNET_PCD="${SCANNET_PCD:-/path/to/SceneVerse/ScanNet/scan_data/pcd_with_global_alignment}"
export RSCAN_PCD="${RSCAN_PCD:-/path/to/SceneVerse/3RScan}"     # <scan>/pcd-align.pth (LEO's 3RScan-ours-align)
export MULTISCAN_PCD="${MULTISCAN_PCD:-/path/to/SceneVerse/MultiScan/pcd_with_global_alignment}"
export MASK3D_DIR="${MASK3D_DIR:-/path/to/mask}"                # Mask3D <scan>.mask.npz (LEO_data mask.zip)
export JUDGE_ENV="${JUDGE_ENV:-/path/to/judge-venv}"     # python env with openai==3.41.0 (Beacon3D judge)
# export OPENAI_API_KEY=...                                     # Beacon3D QA judge (score.sh)
